# Conexión a Postgres (Neon / Vercel Postgres). En Vercel la crea la integración de Neon.
DATABASE_URL="postgresql://usuario:contraseña@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Contraseña para entrar en /panel
ADMIN_PASSWORD="cambia-esta-contraseña"

# Opcional: secreto para firmar la cookie de sesión (si falta se usa ADMIN_PASSWORD)
SESSION_SECRET="una-cadena-larga-y-aleatoria"
